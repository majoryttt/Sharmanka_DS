# Токен Discord бота (ОБЯЗАТЕЛЬНО)
# Получите на https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Токен Яндекс.Музыки (РЕКОМЕНДУЕТСЯ для воспроизведения полных треков в высоком качестве)
# Без токена будет использоваться автоматический поиск треков на YouTube.
# Как получить токен: см. инструкцию в README.md
YANDEX_MUSIC_TOKEN=

# Spotify API (Опционально, для быстрого парсинга плейлистов/альбомов через официальный API)
# Получите на https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Настройки воспроизведения по умолчанию
DEFAULT_VOLUME=100
# Время ожидания в секундах до автоотключения бота при пустом канале или окончании очереди
IDLE_TIMEOUT_SECONDS=300

# Путь к файлу cookies для yt-dlp (опционально, если YouTube блокирует запросы)
# YTDL_COOKIES_FILE=cookies.txt
